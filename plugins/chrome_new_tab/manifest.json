{
  "manifest_version": 3,
  "name": "ChatGPT New Tab",
  "version": "1.2.0",
  "description": "Open ChatGPT in every new tab and personalize it with a local background.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "设置 ChatGPT 背景",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["chatgpt-theme.css"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
